# Changed the backup variable name convention to allow nested virtual env
#
# This file must be used with "source bin/activate" *from bash*
# you cannot run it directly


if ! [ -z "${SCRIPT_PATH+_}" ] ; then
    _OLD2_SCRIPT_PATH="$SCRIPT_PATH"
fi

if ! [ -z "${VIRTUAL_ENV+_}" ] ; then
    _OLD2_VIRTUAL_ENV="$VIRTUAL_ENV"
fi

if ! [ -z "${VIRTUAL_ENV_PROMPT+_}" ] ; then
    _OLD2_VIRTUAL_ENV_PROMPT="$VIRTUAL_ENV_PROMPT"
fi

# Get script path (only used if environment is relocatable).
if [ -n "${BASH_VERSION:+x}" ] ; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
    if [ "$SCRIPT_PATH" = "$0" ]; then
        # Only bash has a reasonably robust check for source'dness.
        echo "You must source this script: \$ source $0" >&2
        exit 33
    fi
elif [ -n "${ZSH_VERSION:+x}" ] ; then
    SCRIPT_PATH="${(%):-%x}"
elif [ -n "${KSH_VERSION:+x}" ] ; then
    SCRIPT_PATH="${.sh.file}"
fi

deactivate2 () {
    # reset old environment variables
    # ! [ -z ${VAR+_} ] returns true if VAR is declared at all
    if ! [ -z "${_OLD2_VIRTUAL_PATH:+_}" ] ; then
        PATH="$_OLD2_VIRTUAL_PATH"
        export PATH
        unset _OLD2_VIRTUAL_PATH
    fi
    if ! [ -z "${_OLD2_VIRTUAL_PYTHONHOME:+_}" ] ; then
        PYTHONHOME="$_OLD2_VIRTUAL_PYTHONHOME"
        export PYTHONHOME
        unset _OLD2_VIRTUAL_PYTHONHOME
    fi
    if ! [ -z "${_OLD2_VIRTUAL_ENV:+_}" ] ; then
        VIRTUAL_ENV="$_OLD2_VIRTUAL_ENV"
        export VIRTUAL_ENV
        unset _OLD2_VIRTUAL_ENV
    else
        unset VIRTUAL_ENV
    fi
    if ! [ -z "${_OLD2_VIRTUAL_ENV_PROMPT:+_}" ] ; then
        VIRTUAL_ENV_PROMPT="$_OLD2_VIRTUAL_ENV_PROMPT"
        export VIRTUAL_ENV_PROMPT
        unset _OLD2_VIRTUAL_ENV_PROMPT
    else
        unset VIRTUAL_ENV_PROMPT
    fi

    # The hash command must be called to get it to forget past
    # commands. Without forgetting past commands the $PATH changes
    # we made may not be respected
    hash -r 2>/dev/null

    if ! [ -z "${_OLD2_VIRTUAL_PS1:+_}" ] ; then
        PS1="$_OLD2_VIRTUAL_PS1"
        export PS1
        unset _OLD2_VIRTUAL_PS1
    fi

    if [ ! "${1-}" = "nondestructive" ] ; then
    # Self destruct!
        unset -f deactivate2
    fi
}

# unset irrelevant variables
deactivate2 nondestructive

VIRTUAL_ENV="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && cd .. && pwd)"
export VIRTUAL_ENV

# Unset the `SCRIPT_PATH` variable, now that the `VIRTUAL_ENV` variable
# has been set. This is important for relocatable environments.
if ! [ -z "${_OLD2_SCRIPT_PATH:+_}" ] ; then
    SCRIPT_PATH="$_OLD2_SCRIPT_PATH"
    export SCRIPT_PATH
    unset _OLD2_SCRIPT_PATH
else
    unset SCRIPT_PATH
fi

_OLD2_VIRTUAL_PATH="$PATH"
PATH="$PATH:$VIRTUAL_ENV/bin"
export PATH

if [ "x" != x ] ; then
    VIRTUAL_ENV_PROMPT=""
else
    VIRTUAL_ENV_PROMPT=$(basename "$VIRTUAL_ENV")
fi
export VIRTUAL_ENV_PROMPT

# unset PYTHONHOME if set
if ! [ -z "${PYTHONHOME:+_}" ] ; then
    _OLD2_VIRTUAL_PYTHONHOME="$PYTHONHOME"
    unset PYTHONHOME
fi

if [ -z "${VIRTUAL_ENV_DISABLE_PROMPT-}" ] ; then
    _OLD2_VIRTUAL_PS1="${PS1-}"
    PS1="(${VIRTUAL_ENV_PROMPT}) ${PS1-}"
    export PS1
fi

# The hash command must be called to get it to forget past
# commands. Without forgetting past commands the $PATH changes
# we made may not be respected
hash -r 2>/dev/null || true
